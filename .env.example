# Server Configuration
PORT=8080
NODE_ENV=production

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/network_monitor?sslmode=disable
# Or use individual parameters:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=network_monitor
# DB_SSLMODE=disable

# Agent Configuration
METRICS_PORT=9090

# Prometheus Configuration (optional - if running separate Prometheus instance)
PROMETHEUS_URL=http://localhost:9091

# Logging
LOG_LEVEL=info  # debug, info, warn, error

# Agent Settings
ICMP_POLL_INTERVAL=60  # seconds
SNMP_POLL_INTERVAL=60  # seconds

# =============================================================================
# ThothOS Integration (Required for managed mode)
# =============================================================================

# ThothOS API URL
# Production: https://thothos.net
# Local development: http://localhost:3000
THOTHOS_URL=https://thothos.net

# ThothOS API Key
# Generate this in ThothOS Dashboard > Network Administration > API Keys
# Format: tk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
THOTHOS_API_KEY=

# Proxy Callback URL (optional)
# URL where ThothOS can reach this proxy for webhooks
# If not set, the proxy will try to auto-detect using its outbound IP
# Example: http://192.168.1.100:8080
PROXY_CALLBACK_URL=

# Proxy Name (optional)
# Human-readable name for this proxy in ThothOS
# If not set, defaults to "Network-Monitor-{hostname}"
PROXY_NAME=
