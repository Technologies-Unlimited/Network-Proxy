{
  "name": "network-proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"next dev\" \"bun run dev:server\"",
    "build": "next build",
    "start": "concurrently \"next start\" \"bun run start:server\"",
    "lint": "next lint",
    "test": "jest",
    "dev:server": "bun --watch src/server.ts",
    "start:server": "bun src/server.ts"
  },
  "dependencies": {
    "@emotion/cache": "^11",
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "@mui/icons-material": "^7",
